# ===== لا تشارك هذا الملف مع أحد =====

# المزود: gemini أو openai (أي خادم متوافق مع OpenAI: Ollama، vLLM، LM Studio، ...)
LLM_PROVIDER=gemini
GEMINI_API_KEY=ضع_مفتاحك_هنا

# اسم شبكة Docker التي يعمل عليها postgres_vector (انظر README)
PG_NETWORK=اسم_الشبكة

# اتصال قاعدة البيانات: المضيف هو اسم الحاوية postgres_vector
DATABASE_URL=postgresql://rag_demo:كلمة_مرور_قوية@postgres_vector:5432/rag_demo

# النماذج المجانية (يمكن تغييرها دون تعديل الكود)
CHAT_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ── مثال للتحويل إلى نموذج محلي عبر Ollama (احذف # من أول كل سطر، وضع # أمام إعدادات Gemini) ──
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=none
# CHAT_MODEL=qwen2.5:7b
# EMBED_MODEL=bge-m3
# EMBED_DIM=1024
# LLM_TIMEOUT=180
# لنماذج nomic-embed-text فقط:
# EMBED_DOC_PREFIX=search_document: 
# EMBED_QUERY_PREFIX=search_query: 

# حدود حماية النسخة التجريبية
MAX_UPLOAD_MB=5
MAX_PAGES=40
MAX_DOCS_PER_SESSION=3
QUESTIONS_PER_HOUR=30
UPLOADS_PER_HOUR=6
# اجعله أقل من حد الطلبات اليومي (RPD) الظاهر لنموذجك في Google AI Studio
DAILY_QUESTION_CAP=200
RETENTION_HOURS=24
