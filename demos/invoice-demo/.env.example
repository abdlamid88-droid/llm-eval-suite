# ===== لا تشارك هذا الملف مع أحد =====
# يمكنك استخدام نفس مفتاح ديمو RAG (مشروع Google منفصل عن عملك)
GEMINI_API_KEY=ضع_مفتاحك_هنا
GEMINI_MODEL=gemini-3.1-flash-lite

# حدود حماية النسخة التجريبية
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=3
EXTRACTS_PER_HOUR=10
# اجعله أقل من حد الطلبات اليومي (RPD) للنموذج في AI Studio، مع حساب ما يستهلكه ديمو RAG
DAILY_EXTRACT_CAP=150
